# OpenAI-compatible (vLLM Qwen via local tunnel)
OPENAI_BASE_URL=http://127.0.0.1:18000/v1
OPENAI_API_KEY=EMPTY
MODEL_NAME=/home/data/data_taihy/Qwen2.5-32B-AWQ

# Agent
MAX_STEPS=10

# MCP gateway (Phase 2+)
MCP_GATEWAY_URL=http://127.0.0.1:8090/mcp
MCP_ENABLED=false
MCP_CALLER_ID=yu-manus-langgraph

# API
API_HOST=127.0.0.1
API_PORT=8200

# CE-2.1：Agent 可读写沙箱（相对路径相对仓库根）
# 默认 artifacts/agent_workspace，避免写文件落到仓库源码根；改真实工程时设为目标路径；"." = 仓库根
WORKSPACE_ROOT=artifacts/agent_workspace

# CA-1：写文件（UTF-8 字节上限；覆盖前是否写 *.ca1.bak）
MAX_WRITE_BYTES=512000
WRITE_BACKUP=true

# CA-2：受控 shell（超时秒；捕获输出字符上限）
SHELL_TIMEOUT_SEC=60
SHELL_MAX_OUTPUT_CHARS=80000

# CA-4：SQLite checkpointer（相对仓库根）；false 则不持久化（仅内存单次）
CHECKPOINT_ENABLED=true
CHECKPOINT_SQLITE_PATH=artifacts/checkpoints/manus.sqlite

# CA-6 HITL：人工确认总开关（S1 起生效于策略；S3 后才拦截真实执行）
HITL_ENABLED=true

# CE-3：工具结果 ≥ 该字符数则落盘到 TOOL_OUTPUT_DIR（相对工作根；可手动删除，无自动清理）
TOOL_RESULT_FILE_THRESHOLD=1000
TOOL_OUTPUT_DIR=artifacts/tool_outputs

# CE-5：发给模型的最近回合数（完备投影 CTX-1 另做）
CONTEXT_MAX_TURNS=5

# CE-6 / IDX-WS / EMB-1：仅 bge（禁止 stub）。测 EMB 前必须开隧道 18001→8001
# SEARCH_MODE=workspace 扫整个 WORKSPACE_ROOT；corpus=仅 SEARCH_CORPUS_DIR（旧 Demo）
SEARCH_MODE=workspace
SEARCH_CORPUS_DIR=artifacts/corpus
SEARCH_INDEX_DIR=artifacts/search_index
SEARCH_CHUNK_LINES=40
SEARCH_CHUNK_OVERLAP=10
SEARCH_IGNORE_DIRS=.git,.venv,venv,node_modules,__pycache__,.pytest_cache,search_index,.idea,.vscode
SEARCH_GLOBS=*.py,*.md,*.txt,*.json,*.yml,*.yaml,*.toml,*.java,*.ts,*.tsx,*.js,*.go
# 上限：单文件过大则跳过；整仓 chunk 过多则建索引报错（见 IDX-WS 计划）
SEARCH_MAX_FILE_BYTES=512000
SEARCH_MAX_CHUNKS=8000
EMBEDDING_BACKEND=http
EMBEDDING_BASE_URL=http://127.0.0.1:18001/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT=60
# 与 Qwen 同机探针（2026-11-24）：单条约 2000 字 + batch=4 较稳；过大易 500/OOM
EMBEDDING_MAX_BATCH=4
EMBEDDING_MAX_CHARS=2000

# CE-6 hybrid：embedding 权重（BM25 权重 = 1 - HYBRID_ALPHA）
HYBRID_ALPHA=0.5
